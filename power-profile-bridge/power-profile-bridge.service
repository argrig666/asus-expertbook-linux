[Unit]
Description=Apply the power profile to every platform-profile handler
Documentation=https://github.com/burakgon/asus-expertbook-linux
# Runs exactly while the daemon runs: enabling adds the bridge to the daemon's
# .wants, so it starts whenever the daemon does (at boot or on D-Bus
# activation, which is how KDE usually starts it), and PartOf= stops or
# restarts it with the daemon. It never pulls the daemon in: that unit
# conflicts with TLP and tuned.
After=power-profiles-daemon.service
PartOf=power-profiles-daemon.service
ConditionPathExistsGlob=/sys/class/platform-profile/platform-profile-*

[Service]
Type=simple
ExecStart=/usr/local/bin/power-profile-bridge
Restart=on-failure
RestartSec=5

# Needs: the system D-Bus and writes to /sys/class/platform-profile.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
IPAddressDeny=any

[Install]
WantedBy=power-profiles-daemon.service
