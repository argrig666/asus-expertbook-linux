[Unit]
Description=Apply the power profile to every platform-profile handler
Documentation=https://github.com/burakgon/asus-expertbook-linux
# Ordered after the daemon but never pulls it in: its unit conflicts with TLP
# and tuned. The bridge exits quietly when the daemon is not running.
After=power-profiles-daemon.service
ConditionPathExistsGlob=/sys/class/platform-profile/platform-profile-*

[Service]
Type=simple
ExecStart=/usr/local/bin/power-profile-bridge
# Leave the handlers agreeing again, so the legacy platform_profile stops
# reading "custom" once the bridge is gone.
# ($$ is a literal $ in unit files.)
ExecStopPost=/bin/sh -c 'f=/sys/firmware/acpi/platform_profile; [ "$$(cat $$f 2>/dev/null)" = custom ] && echo balanced >$$f || true'
Restart=on-failure
RestartSec=5

# Needs: the system D-Bus and writes to /sys/class/platform-profile.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
